local RenderLayers = require "mvtk.ui.render_layers"
-- developer/ui/game/fade.gui_script
local Viewport = require "mvtk.ui.viewport"
local C = require("mvtk.core.constants")
local Pause = require "mvtk.core.pause"
local Settings = require "mvtk.core.settings"
local Accessibility = require "mvtk.ui.accessibility"
local StartupCover = require "mvtk.game.startup_cover"

function init(self)
    gui.set_render_order(RenderLayers.transitions)
	self.rect = gui.get_node("fade")  -- a full-screen box node named "fade"
	Viewport.cover(self.rect)
	self._view_revision = Viewport.revision()
	self.duration = 0.25
	self.t = 0
	self.mode = "idle"
	self._flash_now = 0
	gui.set_color(self.rect, vmath.vector4(0, 0, 0, 0))
	C.URL.FADE_GUI = msg.url()
end

local function set_alpha(node, a)
	local c = gui.get_color(node); c.w = a; gui.set_color(node, c)
end

-- A flash borrows the fade box only while no fade is showing, then hands it
-- back black and clear. A fade always wins over a flash.
local function end_flash(self)
	if self.flash then
		self.flash = nil
		gui.set_color(self.rect, vmath.vector4(0, 0, 0, self.t))
	end
end

local function start_flash(self, message)
	-- A finished fade-out stays in mode "out" at t = 0, which is clear.
	if self.mode == "in" or self.t > 0 then return end
	self.mode = "idle"
	local color = message and message.color
	local duration = tonumber(message and message.duration) or 0.15
	if duration <= 0 then return end
	color = color or vmath.vector4(1, 1, 1, 0.5)
	color, duration = Accessibility.flash(Settings.get_accessibility(), color, duration, self._flash_now, self._last_flash)
	if not color then return end
	self._last_flash = self._flash_now
	self.flash = {
		color = vmath.vector4(color.x, color.y, color.z, color.w),
		duration = duration,
		left = duration,
	}
	gui.set_color(self.rect, self.flash.color)
end

local function step_flash(self, dt)
	local flash = self.flash
	if not flash then return end
	-- This box draws above menus, so a menu pause ends the flash rather than
	-- holding a tinted screen over the menu.
	if Pause.get() then end_flash(self) return end
	flash.left = flash.left - dt
	if flash.left <= 0 then
		end_flash(self)
		return
	end
	local c = flash.color
	gui.set_color(self.rect, vmath.vector4(c.x, c.y, c.z, c.w * flash.left / flash.duration))
end

function update(self, dt)
	self._flash_now = self._flash_now + dt
	local view_revision = Viewport.revision()
	if self._view_revision ~= view_revision then
		Viewport.cover(self.rect)
		self._view_revision = view_revision
	end
	step_flash(self, dt)
	if self.mode == "in" then
		self.t = math.min(1, self.t + dt / self.duration)
		set_alpha(self.rect, self.t)
	elseif self.mode == "out" then
		self.t = math.max(0, self.t - dt / self.duration)
		set_alpha(self.rect, self.t)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("startup_cutscene_black") then
		end_flash(self)
		self.mode, self.t, self.startup_black = "idle", 1, true
		set_alpha(self.rect, 1)
		StartupCover.handoff()
	elseif message_id == C.MSG.FLASH_SCREEN then
		start_flash(self, message)
	elseif message_id == C.MSG.FADE_TO_BLACK then
		end_flash(self)
		if message and message.duration then
			self.duration = tonumber(message.duration) or self.duration
		end
		self.mode = "in"; self.t = self.startup_black and 1 or 0
		self.startup_black = nil
		if message and message.done then
			timer.delay(self.duration, false, function()
				msg.post(message.done, hash("fade_done"), {token=message.token})
			end)
		end
	elseif message_id == C.MSG.FADE_FROM_BLACK then
		self.startup_black = nil
		end_flash(self)
		if message and message.duration then
			self.duration = tonumber(message.duration) or self.duration
		end
		if message and (message.instant or message.force) then
			self.mode = "idle"
			self.t = 0
			set_alpha(self.rect, 0)
			return
		end
		-- Ensure we start fully black before fading out
		self.t = 1
		set_alpha(self.rect, 1)
		local delay = tonumber(message and message.delay) or 0
		if delay > 0 then
			-- Stay black for a moment before fading out
			timer.delay(delay, false, function()
				self.mode = "out"
			end)
		else
			self.mode = "out"
		end
	end
end
 
 


