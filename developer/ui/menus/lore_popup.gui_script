local RenderLayers = require "mvtk.ui.render_layers"
-- developer/ui/menus/lore_popup.gui_script
-- Lore popup panel with text scrolling.

local Viewport = require "mvtk.ui.viewport"
local InputCtl = require "mvtk.rooms.input_controller"
local InputPrompts = require "mvtk.ui.input_prompts"
local DisplayText = require "mvtk.ui.display_text"
local Reading = require "mvtk.ui.reading_text"
local ReaderBuffer = require "mvtk.ui.reader_buffer"

local v3 = vmath.vector3
local v4 = vmath.vector4

local MSG_OPEN = hash("open_lore_popup")
local MSG_CLOSE = hash("close_lore_popup")

local function n(id)
    local ok, node = pcall(gui.get_node, id)
    return ok and node or nil
end

local function set_active(self, on, preserve_blocked)
    self.active = on and true or false
    if InputCtl and InputCtl.set_hud_covered then InputCtl.set_hud_covered(self, self.active) end
    msg.post(".", self.active and "enable" or "disable")
    if self.active then
        msg.post(".", "acquire_input_focus")
        if InputCtl and InputCtl.set_blocked then
            InputCtl.set_blocked(true, "lore_popup")
        end
    else
        msg.post(".", "release_input_focus")
        if not preserve_blocked and InputCtl and InputCtl.set_blocked then
            InputCtl.set_blocked(false)
        end
    end
end

local function wrap_line(out, raw_line, max_chars)
    local words = {}
    for token in raw_line:gmatch("%S+") do
        words[#words + 1] = token
    end
    if #words == 0 then
        out[#out + 1] = ""
        return
    end

    local line = words[1]
    for i = 2, #words do
        local candidate = line .. " " .. words[i]
        if #candidate <= max_chars then
            line = candidate
        else
            out[#out + 1] = line
            line = words[i]
        end
    end
    out[#out + 1] = line
end

local function wrap_lines(text, max_chars)
    local out = {}
    local source = tostring(text or ""):gsub("\r\n", "\n")
    if source == "" then
        return { "" }
    end

    for line in (source .. "\n"):gmatch("(.-)\n") do
        if line == "" then
            out[#out + 1] = ""
        else
            wrap_line(out, line, max_chars)
        end
    end

    if #out == 0 then
        out[1] = ""
    end
    return out
end

local function rebuild(self)
    local title_text = self.title_text or ""
    gui.set_text(self.title, self.title_key and DisplayText.ui(self.title_key) or (title_text ~= "" and DisplayText.render(title_text) or DisplayText.ui("lore.title")))

    -- Category and lore ids are save identities, not player-facing names.
    gui.set_text(self.meta, "")

    local scale = Reading.scale()
    Reading.resize(gui, self.body, self.body_base, scale, self.body_size.x, self.body_size.y)
    Reading.resize(gui, self.title, self.title_base, scale, self.title_size.x, self.title_size.y)
    -- Use the current authored base and reading preference together. The old
    -- character heuristic assumed smaller glyphs and overflowed at 18 px.
    local glyph_width, line_height = Reading.metrics(gui, resource, self.body, "M", self.body_size.x)
    local body_max_chars = math.max(1, math.floor(self.body_size.x / math.max(1, glyph_width)))
    local body_max_lines = math.max(1, math.floor(self.body_size.y / math.max(1, line_height)))

    local wrapped = wrap_lines(self.body_key and DisplayText.ui(self.body_key) or DisplayText.render(self.body_text), body_max_chars)
    local max_scroll = math.max(0, #wrapped - body_max_lines)
    if self.scroll > max_scroll then
        self.scroll = max_scroll
    end

    local first = self.scroll + 1
    local last = math.min(#wrapped, first + body_max_lines - 1)
    local visible = {}
    for i = first, last do
        visible[#visible + 1] = wrapped[i]
    end
    gui.set_text(self.body, table.concat(visible, "\n"))

    if max_scroll > 0 then
        gui.set_text(self.scroll_hint, DisplayText.ui("lore.scroll", {current=self.scroll + 1, total=max_scroll + 1}))
    else
        gui.set_text(self.scroll_hint, "")
    end

    self.max_scroll = max_scroll
    gui.set_text(self.hint_node, DisplayText.legend({
        { command = "confirm", text_key = "gameplay.close" }, { command = "back", text_key = "gameplay.close" },
    }))
    self._prompt_revision = DisplayText.revision()
    self._reading_revision = Reading.revision()
end

local function open_popup(self, message)
    self._menu_stick_guard = nil
    self.opener = message and message.opener
    if message and message.reader then
        message = ReaderBuffer.take(message.reader)
        if not message then return end
    end
    self.title_key, self.body_key = message and message.title_key, message and message.text_key
    self.title_text = tostring((message and message.title) or "")
    self.body_text = tostring((message and message.text) or "")
    self.category_text = tostring((message and message.category) or "")
    self.lore_id_text = tostring((message and message.lore_id) or "")
    self.scroll = 0

    set_active(self, true)
    rebuild(self)
end

local function close_popup(self, preserve_blocked)
    if not self.active then return end
    self.title_text = ""
    self.body_text = ""
    self.category_text = ""
    self.lore_id_text = ""
    self.scroll = 0
    self.max_scroll = 0
    set_active(self, false, preserve_blocked)
    if self.opener then msg.post(self.opener, "lore_popup_closed"); self.opener = nil end
end

function init(self)
    gui.set_render_order(RenderLayers.popups)
    self.backdrop = n("backdrop")
    Viewport.cover(self.backdrop)
    self._view_revision = Viewport.revision()
    self.root = n("root")
    self.title = n("title")
    self.meta = n("meta")
    self.body = n("body")
    self.body_base, self.title_base = gui.get_scale(self.body), gui.get_scale(self.title)
    self.body_size, self.title_size = gui.get_size(self.body), gui.get_size(self.title)
    self.scroll_hint = n("scroll_hint")
    self.hint_node = n("hint")
    local status = n("status")
    if status then gui.set_text(status, "") end

    self.active = false
    self.title_text = ""
    self.body_text = ""
    self.category_text = ""
    self.lore_id_text = ""
    self.scroll = 0
    self.max_scroll = 0

    set_active(self, false)
end

function final(self)
    close_popup(self)
end

function on_message(self, message_id, message, sender)
    if message_id == MSG_OPEN then
        open_popup(self, message)
        return
    end
    if message_id == MSG_CLOSE then
        close_popup(self, message and message.preserve_blocked)
        return
    end
end

function on_input(self, action_id, action)
    if InputCtl and InputCtl.note_device then InputCtl.note_device(action_id, action) end
    local menu_pressed = require("mvtk.ui.menu_nav").pressed(self, action_id, action)
    if self.active and self._prompt_revision ~= DisplayText.revision() then rebuild(self) end
    if not self.active or not action or not menu_pressed then
        return
    end

    if InputPrompts.menu_matches("confirm", action_id) or InputPrompts.menu_matches("back", action_id) then
        close_popup(self)
        return true
    end

    if InputPrompts.menu_matches("down", action_id) then
        if self.max_scroll > 0 then
            self.scroll = math.min(self.max_scroll, self.scroll + 1)
            rebuild(self)
        end
        return true
    end

    if InputPrompts.menu_matches("up", action_id) then
        if self.max_scroll > 0 then
            self.scroll = math.max(0, self.scroll - 1)
            rebuild(self)
        end
        return true
    end
end

function update(self, dt)
    if self.active and (self._prompt_revision ~= DisplayText.revision()
        or self._reading_revision ~= Reading.revision()) then rebuild(self) end
    local view_revision = Viewport.revision()
    if self._view_revision ~= view_revision then
        Viewport.cover(self.backdrop)
        self._view_revision = view_revision
    end
end
