local GeneratedText = require "mvtk.ui.generated_text"
local ViewPolicy = require "mvtk.render.view_policy"
local RenderLayers = require "mvtk.ui.render_layers"
local Viewport = require "mvtk.ui.viewport"
local InputPrompts = require "mvtk.ui.input_prompts"
local DisplayText = require "mvtk.ui.display_text"
local Reading = require "mvtk.ui.reading_text"
local MenuText = require "mvtk.ui.menu_text"
local CurrencyText = require "mvtk.ui.currency_text"
local HudAbilities = require "mvtk.ui.hud_abilities"
local AbilityConfig = require "developer.config.abilities"
-- developer/ui/shared/mode_hud.gui_script
-- HUD with visual GUI nodes that developers can edit in the Defold IDE

local Inv = require "mvtk.core.inventory"
local FlagsOk, Flags = pcall(require, 'mvtk.core.flags')
local MSG_MENU_SHOW = hash("menu_show")
local MSG_MENU_BACK = hash("back_to_menu")

local v3 = vmath.vector3

-- Load UI configuration
local ThemeOk, Theme = pcall(require, "developer.config.ui_theme")
local LayoutOk, Layout = pcall(require, "developer.config.hud_layout")
local RuntimeSettings=require "developer.config.runtime_settings"
local HudLayout=require "mvtk.ui.hud_layout"
local PromptStyle=require "mvtk.ui.prompt_style"
local LayoutOverrides=(RuntimeSettings.load() or {}).hud_layout or {}
if ThemeOk then Theme=RuntimeSettings.section("ui_theme",Theme) end
if LayoutOk then Layout=RuntimeSettings.section("hud_layout",Layout) end
if ThemeOk and LayoutOk then Theme=HudLayout.theme(Theme,Layout,(RuntimeSettings.load() or {}).ui_theme) end

-- Fallback to defaults if configs not found
if not ThemeOk or not Theme then
  Theme = {
    colors = {
      health = {0.9, 0.1, 0.1, 0.95}, health_bg = {0, 0, 0, 0.6},
      energy = {0.2, 0.5, 1.0, 0.95}, energy_bg = {0, 0, 0, 0.6},
      stamina = {0.2, 0.9, 0.3, 0.95}, stamina_bg = {0, 0, 0, 0.6},
      currency = {1, 1, 0.7, 1}, text_primary = {1, 1, 1, 1},
      abilities = {0.8, 0.9, 1, 0.9},
      interact_hint = {0.9, 0.9, 0.9, 0.9}
    },
    spacing = { margin_left = 8, margin_top = 8 },
    sizes = { health_bar_width = 180, health_bar_height = 14,
              energy_bar_width = 100, energy_bar_height = 10,
              stamina_bar_width = 100, stamina_bar_height = 8, bar_border = 2 }
  }
end

if not LayoutOk or not Layout then
  Layout = {
    mode_label = { offset = {x = 8, y = -26} },
    health_bar = { offset = {x = 8, y = -48} },
    energy_bar = { offset = {x = 8, y = -64} },
    stamina_bar = { offset = {x = 8, y = -76} },
    currency = { offset = {x = 8, y = -88} },
    abilities = { offset = {x = 8, y = -106} },
    interact_hint = { offset = {x = 8, y = -142} },
    cooldown_flash = { offset = {x = 120, y = -48} }
  }
end

-- Extract commonly used values
local MARGIN_LEFT = Theme.spacing.margin_left or 8
local MARGIN_TOP = Theme.spacing.margin_top or 8

local layout_entries={}
local function merged_layout_entry(name)
    if not layout_entries[name] then layout_entries[name]=HudLayout.entry(Layout,name,LayoutOverrides) end
    return layout_entries[name]
end
local hint_style = PromptStyle.entry(Layout,"interact_hint",LayoutOverrides)

local collapse_column = (Layout.global or {}).collapse_column or {}
local column_members = {}
for _, name in ipairs(collapse_column) do column_members[name] = true end

local function collapsed_entries(self)
    local entries, kept = {}, {}
    if (Layout.global or {}).collapse_hidden == false then return entries end
    for _, name in ipairs(collapse_column) do
        local entry = merged_layout_entry(name)
        if (entry.anchor or "top_left") == "top_left" then
            kept[#kept + 1] = { name = name, entry = entry }
        end
    end
    local freed = 0
    for i, item in ipairs(kept) do
        local entry, offset = item.entry, item.entry.offset or {}
        -- Placement gets its own copy; cached merged entries remain authored.
        local copy = {}
        for key, value in pairs(entry) do copy[key] = value end
        copy.offset = { x = offset.x or 0, y = (offset.y or 0) + freed }
        entries[item.name] = copy
        if self.hud_shown and self.hud_shown[item.name] == false and kept[i + 1] then
            freed = freed + (offset.y or 0) - ((kept[i + 1].entry.offset or {}).y or 0)
        end
    end
    return entries
end

local function is_hud_visible(name, theme_key, default_visible)
    local visible = default_visible ~= false
    if Theme and Theme.visibility and Theme.visibility[theme_key] == false then
        visible = false
    end

    local layout = merged_layout_entry(name)
    if layout.enabled == false or layout.visible == false then
        visible = false
    end

    return visible
end

local function n(id)
    local ok, node = pcall(gui.get_node, id)
    return ok and node or nil
end

local function place_top_left(node)
    if not node then return end
    local w, h = Viewport.design_size()
    gui.set_pivot(node, gui.PIVOT_NW)
    gui.set_position(node, vmath.vector3(MARGIN_LEFT, h - MARGIN_TOP, 0))
end

-- Tutorial popup nodes (created at runtime so GUI file stays unchanged)
local function create_tutorial_nodes(self)
    local w, h = Viewport.design_size()
    self.tutorial_box = gui.new_box_node(vmath.vector3(w * 0.5, h - 140, 0), vmath.vector3(420, 110, 0))
    gui.set_pivot(self.tutorial_box, gui.PIVOT_N)
    gui.set_color(self.tutorial_box, vmath.vector4(0, 0, 0, 0.82))
    self.tutorial_title = GeneratedText.new(gui, "/developer/ui/shared/mode_hud.gui", gui.get_position(self.tutorial_box) + vmath.vector3(0, 26, 0), "")
    gui.set_font(self.tutorial_title, "system")
    gui.set_pivot(self.tutorial_title, gui.PIVOT_N)
    gui.set_color(self.tutorial_title, vmath.vector4(1, 1, 1, 1))
    self.tutorial_body = GeneratedText.new(gui, "/developer/ui/shared/mode_hud.gui", gui.get_position(self.tutorial_box) + vmath.vector3(0, -6, 0), "")
    gui.set_font(self.tutorial_body, "system")
    gui.set_pivot(self.tutorial_body, gui.PIVOT_N)
    gui.set_color(self.tutorial_body, vmath.vector4(0.9, 0.9, 0.9, 1))
    gui.set_visible(self.tutorial_box, false)
    gui.set_visible(self.tutorial_title, false)
    gui.set_visible(self.tutorial_body, false)
    self.tutorial_title_base = gui.get_scale(self.tutorial_title)
    self.tutorial_body_base = gui.get_scale(self.tutorial_body)
    self.tutorial_t = 0
end

local function position_tutorial(self, pos_hint)
    if not self.tutorial_box then return end
    local w, h = Viewport.design_size()
    local y = h - 140
    if pos_hint == "center" then y = h * 0.5 end
    -- The lower message bands now belong to toasts, countdowns and prompts.
    -- The bottom tutorial slot sits above dialogue and below the top tutorial.
    if pos_hint == "bottom" then y = h - ((Layout.tutorial or {}).bottom_top_offset or 280) end
    local box_height = gui.get_size(self.tutorial_box).y
    -- Reading-size changes can grow a centred tutorial into the prompt band.
    -- Move the whole panel above that band, retaining its complete text.
    if hint_style.max_width and hint_style.max_height then
        local prompt=HudLayout.message_rectangle(hint_style,w,h)
        if y-box_height<prompt.top and y>prompt.bottom then
            y=prompt.top+(Layout.column_gap or 0)+box_height
        end
    end
    y = math.max(box_height + 12, math.min(y, h - 12))
    local base = vmath.vector3(w * 0.5, y, 0)
    gui.set_position(self.tutorial_box, base)
    if self.tutorial_title then gui.set_position(self.tutorial_title, base + vmath.vector3(0, -12, 0)) end
    if self.tutorial_body then gui.set_position(self.tutorial_body, base + vmath.vector3(0, -(self.tutorial_body_y or 44), 0)) end
end

local function tutorial_text(key, source)
    if key and key ~= "" then
        local text = DisplayText.ui(key)
        if text ~= key then return text end
    end
    return MenuText.render(source, DisplayText)
end

local function render_tutorial(self)
    local scale = Reading.scale()
    gui.set_text(self.tutorial_title, tutorial_text(self._tutorial_title_key, self._tutorial_title_source))
    gui.set_text(self.tutorial_body, tutorial_text(self._tutorial_body_key, self._tutorial_body_source))
    Reading.resize(gui, self.tutorial_title, self.tutorial_title_base, scale, 396, 32)
    Reading.resize(gui, self.tutorial_body, self.tutorial_body_base, scale, 396, 60)
    local _, title_h = Reading.metrics(gui, resource, self.tutorial_title, gui.get_text(self.tutorial_title), 396)
    local _, body_h = Reading.metrics(gui, resource, self.tutorial_body, gui.get_text(self.tutorial_body), 396)
    self.tutorial_body_y = 12 + title_h + 8
    gui.set_size(self.tutorial_box, vmath.vector3(420, math.max(110, self.tutorial_body_y + body_h + 12), 0))
    position_tutorial(self, self._tutorial_pos)
    self._tutorial_reading_revision = Reading.revision()
    self._tutorial_text_revision = DisplayText.revision()
end

local function show_tutorial(self, title, body, pos_hint, duration, title_key, body_key)
    if not self.tutorial_box then create_tutorial_nodes(self) end
    self._tutorial_pos = pos_hint or "top"
    position_tutorial(self, self._tutorial_pos)
    self._tutorial_title_source, self._tutorial_body_source = title or "", body or ""
    self._tutorial_title_key, self._tutorial_body_key = title_key or (title == nil and "hud.tutorial" or nil), body_key
    render_tutorial(self)
    gui.set_visible(self.tutorial_box, true)
    gui.set_visible(self.tutorial_title, true)
    gui.set_visible(self.tutorial_body, true)
    self.tutorial_t = duration or 4.0
end

local function hide_tutorial(self)
    if not self.tutorial_box then return end
    gui.set_visible(self.tutorial_box, false)
    gui.set_visible(self.tutorial_title, false)
    gui.set_visible(self.tutorial_body, false)
    self.tutorial_t = 0
end

local function align_menu_button(self)
    if not (self.btn and self.btn_label) then return end
    gui.set_pivot(self.btn, gui.PIVOT_NW)
    local size = gui.get_size(self.btn)
    -- Same placement path as the other HUD elements (hud_layout.lua
    -- `menu_button`). Placing it relative to the root added the theme margins
    -- a second time and pushed the button onto the mode label.
    local entry = merged_layout_entry("menu_button")
    local x, y = HudLayout.screen_top_left(entry, Viewport.hud_rect(ViewPolicy.current().hud_frame), size.x, size.y)
    if x then
        gui.set_screen_position(self.btn, v3(x, y, 0))
    else
        gui.set_position(self.btn, v3(8, -8, 0))
    end
    gui.set_enabled(self.btn, entry.enabled ~= false and entry.visible ~= false)
    gui.set_pivot(self.btn_label, gui.PIVOT_CENTER)
    gui.set_position(self.btn_label, v3(size.x * 0.5, -size.y * 0.5, 0))
end

local function layout_root(self)
    local rect = Viewport.hud_rect(ViewPolicy.current().hud_frame)
    if not rect then return end
    local w, h = rect.design_w, rect.design_h
    self._w, self._h = rect.window_w, rect.window_h
    self._viewport_revision = Viewport.revision()
    self._layout_rect = {}
    for key, value in pairs(rect) do self._layout_rect[key] = value end
    local collapsed = collapsed_entries(self)
    if self.root then
        gui.set_pivot(self.root, gui.PIVOT_NW)
        gui.set_position(self.root, vmath.vector3(MARGIN_LEFT, h - MARGIN_TOP, 0))
    end
    position_tutorial(self, self._tutorial_pos or "top")
    align_menu_button(self)
    self._designer_scales=self._designer_scales or {}
    for key,name in pairs({hp_bg="health_bar",energy_bg="energy_bar",stamina_bg="stamina_bar",
        money="currency",abilities="abilities",interact_hint="interact_hint",mode="mode_label",flash="cooldown_flash"}) do
        local node=self[key]
        if node and not (key=="interact_hint" and self.interact_plate) then
            local entry=collapsed[name] or merged_layout_entry(name)
            self._designer_scales[key]=self._designer_scales[key] or gui.get_scale(node)
            local original=self._designer_scales[key]; local scale=(Layout.global or {}).scale or 1
            gui.set_scale(node,v3(original.x*scale,original.y*scale,original.z))
            local size=gui.get_size(node)
            local x,y=HudLayout.screen_top_left(entry,rect,size.x*original.x*scale,size.y*original.y*scale)
            -- Keep child fill bars in their authored NW coordinate system.
            gui.set_pivot(node,gui.PIVOT_NW); gui.set_screen_position(node,v3(x,y,0))
        end
    end
    if self.interact_hint and self.interact_plate then
        PromptStyle.screen_position(gui,self.interact_hint,self.interact_plate,collapsed.interact_hint or hint_style,rect)
        self._hint_layout_dirty = true
    end
end

local function refresh_abilities(self, force)
    if not self.abilities then return end
    local revision = FlagsOk and Flags and Flags.revision() or nil
    if not force and self._abilities_revision == revision then return end
    self._abilities_revision = revision
    local entries = HudAbilities.list(AbilityConfig.abilities, function(id)
        return FlagsOk and Flags and Flags.has(id)
    end)
    local labels = HudAbilities.text(entries, DisplayText)
    gui.set_text(self.abilities, labels ~= "" and DisplayText.ui("hud.abilities", {labels=labels}) or "")
end

function init(self)
    gui.set_render_order(RenderLayers.hud)
    msg.post(".", "acquire_input_focus")
    -- Get all nodes from GUI file
    self.root = n("root")
    self.btn = n("btn_menu")
    self.btn_label = n("btn_menu_label")
    self.mode = n("mode_label")
    self.hp_bg = n("health_bar_bg")
    self.hp_fg = n("health_bar_fg")
    self.energy_bg = n("energy_bar_bg")
    self.energy_fg = n("energy_bar_fg")
    self.stamina_bg = n("stamina_bar_bg")
    self.stamina_fg = n("stamina_bar_fg")
    self.money = n("currency_text")
    self.abilities = n("abilities_text")
    self.interact_hint = n("interact_hint_text")
    self.interact_plate = n("interact_hint_plate")
    self.flash = n("cooldown_flash_text")

    -- Create FPS counter (top-right corner)
    local w, h = Viewport.design_size()
    self.fps_text = GeneratedText.new(gui, "/developer/ui/shared/mode_hud.gui", vmath.vector3(w - 10, h - 10, 0), DisplayText.ui("hud.fps", {count=60}))
    gui.set_font(self.fps_text, "system")
    gui.set_pivot(self.fps_text, gui.PIVOT_NE)
    gui.set_color(self.fps_text, vmath.vector4(1, 1, 0, 1))  -- Yellow for visibility
    gui.set_scale(self.fps_text, vmath.vector3(2, 2, 1))  -- Make it bigger for testing
    gui.set_enabled(self.fps_text, false)  -- Hidden by default
    print("[HUD] FPS text node created at GUI position:", w - 10, h - 10)

    -- FPS tracking
    self.fps_frames = 0
    self.fps_time = 0
    self.fps_current = 60
    self.last_show_fps = false

    layout_root(self)
    msg.post(".", "acquire_input_focus")


    -- Apply theme colors to all elements
    if self.mode then
        gui.set_color(self.mode, vmath.vector4(
            Theme.colors.text_primary[1], Theme.colors.text_primary[2],
            Theme.colors.text_primary[3], Theme.colors.text_primary[4]))
    end

    -- Health bar colors and sizes
    if self.hp_bg then
        gui.set_color(self.hp_bg, vmath.vector4(
            Theme.colors.health_bg[1], Theme.colors.health_bg[2],
            Theme.colors.health_bg[3], Theme.colors.health_bg[4]))
        gui.set_size(self.hp_bg, vmath.vector3(Theme.sizes.health_bar_width, Theme.sizes.health_bar_height, 0))
    end
    if self.hp_fg then
        gui.set_color(self.hp_fg, vmath.vector4(
            Theme.colors.health[1], Theme.colors.health[2],
            Theme.colors.health[3], Theme.colors.health[4]))
        local max_w = Theme.sizes.health_bar_width - (Theme.sizes.bar_border * 2)
        local max_h = Theme.sizes.health_bar_height - (Theme.sizes.bar_border * 2)
        gui.set_size(self.hp_fg, vmath.vector3(max_w, max_h, 0))
    end
    self.hp, self.hp_max = 0, 1

    -- Energy bar colors and sizes
    if self.energy_bg then
        gui.set_color(self.energy_bg, vmath.vector4(
            Theme.colors.energy_bg[1], Theme.colors.energy_bg[2],
            Theme.colors.energy_bg[3], Theme.colors.energy_bg[4]))
        gui.set_size(self.energy_bg, vmath.vector3(Theme.sizes.energy_bar_width, Theme.sizes.energy_bar_height, 0))
    end
    if self.energy_fg then
        gui.set_color(self.energy_fg, vmath.vector4(
            Theme.colors.energy[1], Theme.colors.energy[2],
            Theme.colors.energy[3], Theme.colors.energy[4]))
        local max_w = Theme.sizes.energy_bar_width - (Theme.sizes.bar_border * 2)
        local max_h = Theme.sizes.energy_bar_height - (Theme.sizes.bar_border * 2)
        gui.set_size(self.energy_fg, vmath.vector3(max_w, max_h, 0))
    end
    self.energy, self.energy_max = 0, 0  -- Hidden by default

    -- Stamina bar colors and sizes
    if self.stamina_bg then
        gui.set_color(self.stamina_bg, vmath.vector4(
            Theme.colors.stamina_bg[1], Theme.colors.stamina_bg[2],
            Theme.colors.stamina_bg[3], Theme.colors.stamina_bg[4]))
        gui.set_size(self.stamina_bg, vmath.vector3(Theme.sizes.stamina_bar_width, Theme.sizes.stamina_bar_height, 0))
    end
    if self.stamina_fg then
        gui.set_color(self.stamina_fg, vmath.vector4(
            Theme.colors.stamina[1], Theme.colors.stamina[2],
            Theme.colors.stamina[3], Theme.colors.stamina[4]))
        local max_w = Theme.sizes.stamina_bar_width - (Theme.sizes.bar_border * 2)
        local max_h = Theme.sizes.stamina_bar_height - (Theme.sizes.bar_border * 2)
        gui.set_size(self.stamina_fg, vmath.vector3(max_w, max_h, 0))
    end
    self.stamina, self.stamina_max = 0, 0  -- Hidden by default

    -- Currency text
    self.show_currency = is_hud_visible("currency", "show_currency", true)
    if self.money then
        gui.set_color(self.money, vmath.vector4(
            Theme.colors.currency[1], Theme.colors.currency[2],
            Theme.colors.currency[3], Theme.colors.currency[4]))
        if self.show_currency then
            gui.set_text(self.money, CurrencyText.text(Inv.get_currency(), DisplayText.render))
        else
            gui.set_enabled(self.money, false)
        end
    end

    -- Abilities text
    if self.abilities then
        gui.set_color(self.abilities, vmath.vector4(
            Theme.colors.abilities[1], Theme.colors.abilities[2],
            Theme.colors.abilities[3], Theme.colors.abilities[4]))
        refresh_abilities(self, true)
    end

    -- Interact hint text
    if self.interact_hint then
        if self.interact_plate then PromptStyle.authored_plate(gui,self.interact_plate,hint_style) end
        PromptStyle.tint(gui,self.interact_hint,self.interact_plate,hint_style,0)
        self.interact_flash_t = 0
    end

    -- Cooldown flash text
    if self.flash then
        gui.set_color(self.flash, vmath.vector4(1, 1, 0, 0))
    self.flash_t = 0
    end

    -- Set the Menu button label
    if self.btn_label then
        gui.set_text(self.btn_label, Layout.menu_button and Layout.menu_button.label
            and DisplayText.render(Layout.menu_button.label) or DisplayText.ui("hud.menu"))
    end
    align_menu_button(self)

    -- Tutorial popups
    create_tutorial_nodes(self)
end

local SettingsOk, Settings = pcall(require, "mvtk.core.settings")
-- Every layout entry whose visible flag the HUD honours (mode_label was missing, so it never hid).
local hud_elements={hp_bg="health_bar",hp_fg="health_bar",energy_bg="energy_bar",energy_fg="energy_bar",
    stamina_bg="stamina_bar",stamina_fg="stamina_bar",money="currency",abilities="abilities",interact_hint="interact_hint",
    mode="mode_label"}
local function update_bar(self, key, value, maximum, name)
    local n=self[key]
    if not n then return end
    local fraction=(maximum or 0)>0 and math.max(0,math.min(1,(value or 0)/maximum)) or 0
    self.bar_fractions=self.bar_fractions or {}
    if self.bar_fractions[key]==fraction then return end
    self.bar_fractions[key]=fraction
    gui.set_size(n,vmath.vector3((Theme.sizes[name.."_bar_width"]-Theme.sizes.bar_border*2)*fraction,
        Theme.sizes[name.."_bar_height"]-Theme.sizes.bar_border*2,0))
end
local function interact_text(label)
    if not label or label == "" then return "" end
    local text = MenuText.render(label, DisplayText)
    if text == "" then return "" end
    return DisplayText.ui("hud.interact", {button=InputPrompts.action_label("interact", { device = "active" }),
        label=text})
end

local function render_interact_hint(self)
    if not self.interact_hint then return end
    local text, alpha = "", 0
    if self._interact_show_used and (self.interact_flash_t or 0) > 0 then
        text = DisplayText.ui("hud.used", {label=MenuText.render(self._used_source, DisplayText)})
        alpha = math.min(1, self.interact_flash_t * 4)
    elseif self._gate_hint_text and self._gate_hint_text ~= "" then
        local candidate, gate = self._interact_candidate_url, self._gate_hint_sender
        if self._interact_candidate_active and candidate and gate
            and candidate.socket==gate.socket and candidate.path==gate.path then
            text = interact_text(self._gate_hint_text)
        else text = MenuText.render(self._gate_hint_text, DisplayText) end
        alpha = text ~= "" and 1 or 0
    elseif self._interact_candidate_active then
        text = interact_text(self._interact_hint_hold)
        alpha = text ~= "" and 1 or 0
    end
    -- Use the same UI block and pause state as the feature HUD. Dialogue,
    -- cutscenes and menus all own the input controller's existing block.
    if require("mvtk.core.pause").get() or require("mvtk.rooms.input_controller").get_blocked()
        or not is_hud_visible("interact_hint", "show_interact_hint", true) then alpha = 0 end
    if self._hint_rendered_text ~= text or self._hint_layout_dirty then
        if self.interact_plate then
            PromptStyle.fit(gui,resource,self.interact_hint,self.interact_plate,text,hint_style,(Layout.global or {}).scale or 1,1)
        else gui.set_text(self.interact_hint, text) end
        self._hint_rendered_text = text
        self._hint_layout_dirty = false
    end
    if self._hint_rendered_alpha ~= alpha then
        PromptStyle.tint(gui,self.interact_hint,self.interact_plate,hint_style,alpha)
        self._hint_rendered_alpha = alpha
    end
end

local function same_hint_sender(a, b)
    return a == nil and b == nil or a and b and a.socket == b.socket
        and a.path == b.path and a.fragment == b.fragment
end

local mode_keys = {
    ["Air Dash"]="hud.mode.air_dash", Backdash="hud.mode.backdash", Roll="hud.mode.roll",
    Slide="hud.mode.slide", Recovery="hud.mode.recovery", Compact="hud.mode.compact",
    ["Wall Climb"]="hud.mode.wall_climb", ["Extended Jump"]="hud.mode.extended_jump",
    Blink="hud.mode.blink", ["Super Jump"]="hud.mode.super_jump", Swim="hud.mode.swim", Run="hud.mode.run", Walk="hud.mode.walk",
}
local cooldown_keys = {down="hud.cooldown.down",charged="hud.cooldown.charged",light="hud.cooldown.light",
    heavy="hud.cooldown.heavy",ranged="hud.cooldown.ranged"}

function update(self, dt)
    -- Save loads replace flags without posting an ability message to this GUI.
    refresh_abilities(self, false)
    local revision = DisplayText.revision()
    if self._prompt_revision ~= revision then
        self._prompt_revision = revision
        refresh_abilities(self, true)
        if self.btn_label then
            gui.set_text(self.btn_label, Layout.menu_button and Layout.menu_button.label
                and DisplayText.render(Layout.menu_button.label) or DisplayText.ui("hud.menu"))
        end
        if self.mode and self._mode_source then
            gui.set_text(self.mode, mode_keys[self._mode_source] and DisplayText.ui(mode_keys[self._mode_source])
                or DisplayText.render(self._mode_source))
        end
        if self.flash and self._cooldown_action then
            gui.set_text(self.flash, DisplayText.ui(cooldown_keys[self._cooldown_action] or "hud.unknown_ability"))
        end
        if self.fps_text then gui.set_text(self.fps_text, DisplayText.ui("hud.fps", {count=self.fps_current or 60})) end
        if self.money and self.show_currency then gui.set_text(self.money, CurrencyText.text(self._currency_value or Inv.get_currency(), DisplayText.render)) end
    end
    if (self.tutorial_t or 0) > 0 and (self._tutorial_reading_revision ~= Reading.revision()
        or self._tutorial_text_revision ~= revision) then render_tutorial(self) end
    -- Layout is immutable for this HUD instance. Cache visibility once and only
    -- write enabled state when availability changes (for example energy unlock).
    if not self.hud_visibility then
        self.hud_visibility={}; self.hud_enabled={}
        for key,name in pairs(hud_elements) do
            self.hud_visibility[key]=is_hud_visible(name,"show_"..name:gsub("_bar$",""),true)
        end
    end
    local layout_changed = false
    self.hud_shown = self.hud_shown or {}
    for key,name in pairs(hud_elements) do
        local show=self.hud_visibility[key]
        if name=="energy_bar" then show=show and (merged_layout_entry(name).auto_hide==false or (self.energy_max or 0)>0)
        elseif name=="stamina_bar" then show=show and (merged_layout_entry(name).auto_hide==false or (self.stamina_max or 0)>0) end
        if self.hud_shown[name]~=show then
            self.hud_shown[name]=show
            if column_members[name] then layout_changed=true end
        end
        if self[key] and self.hud_enabled[key]~=show then
            gui.set_enabled(self[key],show); self.hud_enabled[key]=show
        end
    end
    local show_fps=SettingsOk and Settings.get_show_fps() or false
    if self.last_show_fps~=show_fps then
        self.last_show_fps=show_fps
        if self.fps_text then gui.set_enabled(self.fps_text,show_fps) end
    end
    if self.fps_text and show_fps then
        self.fps_frames=self.fps_frames+1; self.fps_time=self.fps_time+dt
        if self.fps_time>=0.5 then
            self.fps_current=math.floor(self.fps_frames/self.fps_time)
            self.fps_frames=0; self.fps_time=0
            gui.set_text(self.fps_text,DisplayText.ui("hud.fps",{count=self.fps_current}))
        end
        local bounds=Viewport.design_bounds(ViewPolicy.current().hud_frame)
        if bounds then
            local w,h=bounds.max_x,bounds.max_y
            if self.fps_w~=w or self.fps_h~=h then
                gui.set_position(self.fps_text,vmath.vector3(w-10,h-10,0)); self.fps_w,self.fps_h=w,h
            end
        end
    end
    local rect=Viewport.hud_rect(ViewPolicy.current().hud_frame)
    if rect then
        if self._viewport_revision ~= Viewport.revision() then layout_changed=true end
        for key,value in pairs(rect) do
            if not self._layout_rect or self._layout_rect[key]~=value then layout_changed=true; break end
        end
        if layout_changed then layout_root(self) end
    end
    update_bar(self,"hp_fg",self.hp,self.hp_max,"health")
    update_bar(self,"energy_fg",self.energy,self.energy_max,"energy")
    update_bar(self,"stamina_fg",self.stamina,self.stamina_max,"stamina")

    -- Flash cooldown text
    if self.flash_t and self.flash_t > 0 then
        self.flash_t = math.max(0, self.flash_t - dt)
        local a = math.min(1, self.flash_t * 4)
        local c = gui.get_color(self.flash)
        c.w = a
        gui.set_color(self.flash, c)
    end

    -- Flash interact hint, then restore the current candidate or gate hint.
    if self.interact_flash_t and self.interact_flash_t > 0 then
        self.interact_flash_t = math.max(0, self.interact_flash_t - dt)
        if self.interact_flash_t == 0 then self._interact_show_used = false end
    end
    render_interact_hint(self)

    -- Tutorial popup lifetime
    if self.tutorial_t and self.tutorial_t > 0 then
        self.tutorial_t = math.max(0, self.tutorial_t - dt)
        if self.tutorial_t == 0 then
            hide_tutorial(self)
        end
    end

end

local function safe_post(target, msg_id, payload)
    local ok_url, url = pcall(msg.url, target)
    if not ok_url or not url then
        return false
    end
    local ok_post = pcall(msg.post, url, msg_id, payload or {})
    return ok_post and true or false
end

local function return_to_menu()
    -- Boot collection socket is "boot", not "main"
    -- Send back_to_menu which handles disable/unload internally
    safe_post("boot:/host#script", MSG_MENU_BACK, {})
end

function on_input(self, action_id, action)
    local is_click = action_id == hash("touch") or action_id == hash("mouse_button_1") or action_id == hash("click")
    if is_click and action.pressed and self.btn and gui.is_enabled(self.btn)
        and not require("mvtk.rooms.input_controller").is_hud_covered()
        and gui.pick_node(self.btn, action.x, action.y) then
        msg.post(".", "release_input_focus")
        return_to_menu()
        return true
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("hud_cooldown") and message and message.action then
        if self.flash then
            self._cooldown_action = tostring(message.action)
            gui.set_text(self.flash, DisplayText.ui(cooldown_keys[self._cooldown_action] or "hud.unknown_ability"))
            self.flash_t = 0.35
            local c = gui.get_color(self.flash)
            c.w = 1
            gui.set_color(self.flash, c)
        end
    elseif message_id == hash("hud_mode") and message and message.mode then
        if self.mode then
            self._mode_source = tostring(message.mode)
            gui.set_text(self.mode, mode_keys[self._mode_source] and DisplayText.ui(mode_keys[self._mode_source])
                or DisplayText.render(self._mode_source))
        end
    elseif message_id == hash("hud_health") and message then
        self.hp = tonumber(message.hp) or self.hp
        self.hp_max = tonumber(message.hp_max) or self.hp_max
    elseif message_id == hash("hud_energy") and message then
        self.energy = tonumber(message.energy) or self.energy
        self.energy_max = tonumber(message.energy_max) or self.energy_max
    elseif message_id == hash("hud_stamina") and message then
        self.stamina = tonumber(message.stamina) or self.stamina
        self.stamina_max = tonumber(message.stamina_max) or self.stamina_max
    elseif message_id == hash("hud_currency") and message then
        if self.money then
            self._currency_value = tonumber(message.value) or Inv.get_currency()
            gui.set_text(self.money, CurrencyText.text(self._currency_value, DisplayText.render))
        end
    elseif message_id == hash('ability_unlocked') and message and message.ability and self.abilities then
        refresh_abilities(self, true)
    elseif message_id == hash("hud_interact_hint") and message and self.interact_hint then
        if not message.keep_used then self._interact_show_used = false end
        self._interact_hint_hold = message.label or ""
        self._interact_candidate_url = message.candidate_url
        self._interact_candidate_active = message.active
        if self._interact_candidate_active == nil then
            self._interact_candidate_active = MenuText.render(self._interact_hint_hold, DisplayText) ~= ""
        end
        render_interact_hint(self)
    elseif message_id == hash("hud_interact") and message and self.interact_hint then
        if message.accepted == false then
            self._interact_show_used = false
            self.interact_flash_t = 0
            render_interact_hint(self)
            return
        end
        local label = message.label or ""
        if MenuText.render(label, DisplayText) ~= "" then
            self._used_source = label
            self._interact_show_used = true
            self.interact_flash_t = 0.6
            render_interact_hint(self)
        end
    elseif message_id == hash("show_hint") and message then
        self._gate_hint_id, self._gate_hint_sender = message.gate_id, sender
        self._gate_hint_text = message.text
        render_interact_hint(self)
    elseif message_id == hash("hide_hint") and message then
        if self._gate_hint_id == message.gate_id and same_hint_sender(self._gate_hint_sender, sender) then
            self._gate_hint_id, self._gate_hint_sender, self._gate_hint_text = nil, nil, nil
            render_interact_hint(self)
        end
    elseif message_id == hash("show_tutorial") and message then
        show_tutorial(self, message.title, message.description, message.position, message.duration, message.title_key, message.body_key)
    end
end
