local RenderLayers = require "mvtk.ui.render_layers"
local Viewport = require "mvtk.ui.viewport"
local DisplayText = require "mvtk.ui.display_text"
local visible = false
local function refresh_text(self)
  gui.set_text(gui.get_node("oxygen"), DisplayText.ui("underwater.oxygen", {percent=self.oxygen or 100}))
  self._text_revision = DisplayText.revision()
end

function init(self)
    gui.set_render_order(RenderLayers.world_overlay)
  self.oxygen = 100
  refresh_text(self)
  self.overlay = gui.get_node("overlay")
  Viewport.cover(self.overlay)
  self._view_revision = Viewport.revision()
  gui.set_alpha(gui.get_node("overlay"), 0.0)
  gui.set_alpha(gui.get_node("oxygen"), 0.0)
end

local function set_visible(v)
  visible = v and true or false
  local a = visible and 0.25 or 0.0
  gui.animate(gui.get_node("overlay"), gui.PROP_COLOR, vmath.vector4(0.2,0.4,0.8,a), gui.EASING_OUTQUAD, 0.15)
  gui.animate(gui.get_node("oxygen"), gui.PROP_COLOR, vmath.vector4(1,1,1, visible and 1 or 0), gui.EASING_OUTQUAD, 0.15)
end

function on_message(self, message_id, message, sender)
  if message_id == hash("underwater_set") then
    set_visible(message and message.enabled)
  elseif message_id == hash("oxygen") then
    local pct = math.max(0, math.min(100, tonumber(message and message.value) or 0))
    self.oxygen = math.floor(pct)
    refresh_text(self)
  end
end

function update(self, dt)
  if self._text_revision ~= DisplayText.revision() then refresh_text(self) end
  local view_revision = Viewport.revision()
  if self._view_revision ~= view_revision then
    Viewport.cover(self.overlay)
    self._view_revision = view_revision
  end
end
