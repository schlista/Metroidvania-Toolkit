-- Runtime attack actor; placed world objects still belong to baked rooms.
local Pause = require "mvtk.core.pause"
local C = require "mvtk.core.constants"

go.property("fuse", 0.9)
go.property("radius", 96.0)
go.property("damage", 3.0)
go.property("knockback", 200.0)
go.property("attack_type", "bomb")
go.property("owner", msg.url())

function init(self)
    self.remaining = self.fuse
    self.exploded = false
    sprite.play_flipbook("#sprite", "player_bomb")
end

function update(self, dt)
    if Pause.get() or self.exploded then return end
    self.remaining = self.remaining - dt
    if self.remaining > 0 then
        local light = 0.65 + 0.35 * math.abs(math.sin(self.remaining * 30))
        go.set("#sprite", "tint", vmath.vector4(1, light, light, 1))
        return
    end
    self.exploded = true
    local pos = go.get_world_position()
    local hitbox = factory.create(C.URL.FACTORY.melee_circle, pos, nil, {
        lifetime = 0.12, damage = self.damage, knockback = self.knockback,
        attack_type = self.attack_type, source_attack = "bomb", source_actor = self.owner,
        hit_enemy = true, hit_breakable = true, debug_shape = "circle", debug_radius = self.radius,
    }, self.radius / 50)
    msg.post(hitbox, "set_owner", { owner = self.owner })
    local cfg = require("mvtk.core.util").require_config("developer.config.player_actions").bomb
    require("mvtk.fx.fx").play(cfg.explosion_fx, pos)
    if cfg.sound_explode ~= "" then require("mvtk.audio.audio").sfx(cfg.sound_explode) end
    require("mvtk.core.gamefeel").impact(self.damage, { shake = cfg.camera_shake })
    go.delete()
end
