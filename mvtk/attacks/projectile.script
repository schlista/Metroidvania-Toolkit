-- mvtk/attacks/projectile.script
local v3 = vmath.vector3
local Pause = require "mvtk.core.pause"
local C = require "mvtk.core.constants"
local Util = require "mvtk.core.util"
local DamagePayload = require "mvtk.combat.damage_payload"
local CombatFeedback = require "mvtk.combat.combat_feedback"
local SurfaceClassifier = require "mvtk.core.surface_classifier"
local AttackTells = require "mvtk.combat.attack_tells"

go.property("speed", 1200.0)
go.property("dir", 1.0)
go.property("dir_x", 0.0)
go.property("dir_y", 0.0)
go.property("projectile_visual", "")
go.property("lifetime", 1.5)
go.property("launch_age", 0) -- Time already due when a scheduled boss launch draws late.
go.property("damage", 1.0)
go.property("status_id", "") -- optional attack-borne status id
go.property("status_chance", 1.0) -- probability [0,1]
go.property("damage_type", "") -- empty preserves the original attack type
go.property("attack_type", "")    -- optional action tag for action barriers
go.property("source_attack", "")  -- standardized combat payload field
go.property("source_actor", msg.url())  -- standardized combat payload field
go.property("boss_id", "")       -- encounter feedback lookup; empty for non-boss attacks
go.property("parryable", true)          -- enemy projectiles are parryable by default
go.property("reaction_type", "")  -- light/medium/heavy/launch/stun
go.property("kx", 0.0)                  -- explicit knockback x
go.property("ky", 0.0)                  -- explicit knockback y
go.property("stun_t", 0.06)             -- optional custom stun duration
go.property("origin_x", 0.0)            -- shooter anchor for the first terrain sweep (see probe_origin)
go.property("origin_y", 0.0)
go.property("probe_origin", false)      -- sweep origin->spawn too, so a shot fired into a wall the shooter touches dies at once
go.property("deflect", "none") -- none, destroy or reflect; player shots keep none.
go.property("reflect_damage_mult", 1.0)
go.property("player_owned", false) -- the player shot prefab sets true; the live shot cap recycles enemy shots first

local function apply_visual(self)
  if self.projectile_visual and self.projectile_visual ~= "" then
    pcall(sprite.play_flipbook, "#sprite", self.projectile_visual)
  end
end

local function direction_angle(dy, dx)
  if math.atan2 then
    return math.atan2(dy, dx)
  end
  if dx > 0 then
    return math.atan(dy / dx)
  elseif dx < 0 then
    return math.atan(dy / dx) + (dy >= 0 and math.pi or -math.pi)
  elseif dy > 0 then
    return math.pi * 0.5
  elseif dy < 0 then
    return -math.pi * 0.5
  end
  return 0
end

local function apply_direction_rotation(dx, dy)
  if (dx == 0 and dy == 0) or not vmath.quat_rotation_z or not go.set_rotation then
    return
  end
  pcall(go.set_rotation, vmath.quat_rotation_z(direction_angle(dy, dx)))
end

local hash_to_string = Util.hash_text

-- Live shot cap (CP04d): every shot counts from init until it is deleted.
local SpawnBudget = require "mvtk.core.spawn_budget"
local PLAYER_OWNER = { owner = "player" }
local Timers = require "mvtk.player.timers"

-- Delete this shot and release its slot at once, so a shot fired later in
-- the same frame never recycles one that is already going.
local function despawn(self)
  if not self.player_owned then self._spent = true end
  SpawnBudget.leave("projectile", go.get_id())
  go.delete(".")
end

-- Terrain that stops a projectile: solid tiles, world objects, room bounds and
-- one-way platforms (the groups enemy line-of-sight rays test against).
local BLOCKING_GROUPS = SurfaceClassifier.RAYCAST.TERRAIN
local GROUP_WORLD = SurfaceClassifier.GROUPS.WORLD

local hit -- defined after update; forward-declared so the sweep can deliver hits
local step

-- Sweep the segment from -> to against terrain. The trigger only reports
-- overlaps with bodies that mask "attack", and baked tile collision does not,
-- so a raycast is what stops the shot. Returns the closest hit or nil.
local function terrain_hit(from, to)
  if not (physics and physics.raycast) then return nil end
  if from.x == to.x and from.y == to.y then return nil end
  local ok, hit = pcall(physics.raycast, from, to, BLOCKING_GROUPS)
  if ok then return hit end
  return nil
end

function init(self)
  local speed = self.speed or 1200
  local dx = self.dir_x or 0
  local dy = self.dir_y or 0
  if dx ~= 0 or dy ~= 0 then
    local len = math.sqrt(dx * dx + dy * dy)
    if len > 0 then
      dx = dx / len
      dy = dy / len
    end
    self.vel = v3(speed * dx, speed * dy, 0)
    self._knock_dir = (dx ~= 0 and dx) or (self.dir or 1)
  else
    local dir = self.dir or 1
    self.vel = v3(speed * dir, 0, 0)
    self._knock_dir = dir
    dx, dy = dir, 0
  end
  -- Over the live cap, the oldest enemy shot (or, with none left, the oldest
  -- player shot) makes room. Nothing is recycled while a boss arena is locked.
  local victims = SpawnBudget.enter("projectile", go.get_id(), self.player_owned and PLAYER_OWNER or nil)
  if victims then
    for i = 1, #victims do pcall(go.delete, victims[i]) end
  end
  apply_visual(self)
  AttackTells.projectile(self)
  apply_direction_rotation(dx, dy)
  self.t = self.lifetime or 1.5
  if self.player_owned then
    Timers.start_combat_window(self, "t", self.t)
  else
    self.t = math.max(0, self.t)
    self._flight_time = 0
  end
  if self.probe_origin then
    self._sweep_from = v3(self.origin_x or 0, self.origin_y or 0, 0)
  end
  self.attack_type_id = (self.attack_type and self.attack_type ~= "") and self.attack_type or nil
  self.source_attack_str = hash_to_string(self.source_attack)
  self.reaction_type_str = hash_to_string(self.reaction_type)
  -- A delayed boss callback already owes a partial travel segment on its
  -- launch draw. Normal factory and player shots start at the muzzle.
  if not self.player_owned and (self.launch_age or 0) > 1e-8 then
    step(self, self.launch_age)
  end
end

step = function(self, dt)
  if self._spent then return end
  if not self.player_owned and dt <= 0 then return end
  local p = go.get_position()
  if self.deflect and self.deflect ~= "none" then
    if require("mvtk.combat.projectile_counterplay").cut(self, p) then return end
  end
  local expired, travel
  local origin = p
  if self.player_owned then
    expired, travel = Timers.tick_combat_deadline(self, "t", dt)
  else
    self._flight_origin = self._flight_origin or p
    origin = self._flight_origin
    self._flight_time = math.min(self.t, self._flight_time + dt)
    expired = self._flight_time + 1e-8 >= self.t
    travel = expired and self.t or self._flight_time
  end
  local to = v3(origin.x + self.vel.x * travel, origin.y + self.vel.y * travel, origin.z)
  local from = self._sweep_from or p
  self._sweep_from = nil
  local blocked = terrain_hit(from, to)
  if blocked then
    -- Stop at walls, floors, ceilings and platforms instead of flying through.
    -- "world" objects (breakable walls, doors, pushable blocks) still receive
    -- the hit so a breakable wall takes projectile damage as before.
    if blocked.group == GROUP_WORLD and blocked.id then
      hit(self, blocked.id)
    else
      despawn(self)
    end
    return
  end
  go.set_position(to)
  if expired then
    self.t = 0
    despawn(self)
  end
end

function update(self, dt)
  if Pause and Pause.get and Pause.get() then return end
  local game_dt = self.player_owned and dt or dt * (Pause.dt_scale and Pause.dt_scale() or 1)
  if game_dt > 0 and self._held_impact ~= nil then
    local target = self._held_impact
    self._held_impact = nil
    if target then hit(self, target) else despawn(self) end
    return
  end
  step(self, game_dt)
end

function hit(self, other)
  -- Deletion is deferred until frame end; consume before any message can re-enter.
  if self._spent then return end
  self._spent = true
  -- Send to the game object id directly so any script component id can handle
  -- damage (e.g. "#enemy", "#script", etc).
  local target = other
  local dmg = self.damage or 1
  local dir = self._knock_dir or (self.dir or 1)
  local payload = DamagePayload.build({
    amount = dmg,
    status_id = self.status_id,
    status_chance = self.status_chance,
    damage_type = self.damage_type ~= "" and self.damage_type or "projectile",
    kx = (self.kx ~= 0) and self.kx or (60 * dir),
    ky = self.ky or 0,
    stun_t = self.stun_t or 0.06,
    parryable = self.parryable == true,
    source_actor = self.source_actor or msg.url(),
    boss_id = self.boss_id,
    source_attack = self.source_attack_str,
    reaction_type = self.reaction_type_str,
    attack_type = self.attack_type_id,
    reflectable = self.deflect == "reflect",
    projectile_speed = self.speed,
    projectile_visual = self.projectile_visual,
    reflect_damage_mult = self.reflect_damage_mult,
  })
  if self.attack_type_id then
    payload.attack_type = self.attack_type_id
  end
  pcall(msg.post, target, hash("mvtk_apply_damage"), payload)
  CombatFeedback.attack_impact("projectile", dmg, self.boss_id, other, {
    sfx = "hit_projectile", player_combat = self.player_owned == true,
  })
  despawn(self)
end

function final(self)
  SpawnBudget.leave("projectile", go.get_id())
end

function on_message(self, message_id, message, sender)
  if not self.player_owned and (self._spent or self._held_impact ~= nil) then return end
  local target = message_id == hash("trigger_response") and message.enter and message.other_id
  local blocked = message_id == hash("contact_point_response")
  if not target and not blocked then return end
  if not self.player_owned and (Pause.get() or Pause.is_hitstopped and Pause.is_hitstopped()) then
    -- The engine can deliver the contact after a menu or freeze begins.
    -- Keep the first impact so a one-shot trigger is paid on resume.
    self._held_impact = target or false
  elseif target then
    hit(self, target)
  else
    despawn(self)
  end
end
