-- An attack-owned visual. The executor owns damage and posts look changes
-- on the same clock as its hit window. The script owns only its visual fade.
local Pause = require "mvtk.core.pause"
local Indicator = require "mvtk.bosses.boss_indicator"

go.property("radius", 150.0)
go.property("duration", 0.35)
go.property("lifetime", 0.0)
go.property("end_pos", vmath.vector3())
go.property("width", 0.0)
go.property("box_height", 0.0)
go.property("managed", false)
go.property("color_r", -1.0)
go.property("color_g", -1.0)
go.property("color_b", -1.0)
go.property("color_a", -1.0)
go.property("ring", false)
go.property("indicator_look", "active")
go.property("single_hit", false)
go.property("minimum_duration", 0)
go.property("warning_color", vmath.vector4(-1, -1, -1, -1))

local LOOK = hash("boss_indicator_look")

local function start_grace(self)
    if self.single_hit then
        self.grace_until = self.elapsed + self.indicator.minimum_active_time
        self.expires_at = math.max(self.expires_at, self.grace_until)
    end
end

local function setup_beam(self)
    local start = go.get_position()
    local delta = vmath.vector3(self.end_pos.x - start.x, self.end_pos.y - start.y, 0)
    local length = vmath.length(delta)
    if length <= 0.0001 then return false end
    go.set_position(vmath.vector3(start.x + delta.x * 0.5, start.y + delta.y * 0.5, start.z))
    go.set_rotation(vmath.quat_rotation_z(math.atan2(delta.y, delta.x)))
    Indicator.setup("beam", length, self.width)
    return true
end

function init(self)
    self.elapsed = 0
    self.indicator = Indicator.config()
    self.effect_warning = true
    self.look = self.indicator_look
    if self.box_height > 0 then
        Indicator.setup("box", self.width, self.box_height)
    elseif self.width <= 0 or not setup_beam(self) then
        Indicator.setup(self.ring and "ring" or "circle", self.radius * 2)
    end
    self.expires_at = math.max(self.minimum_duration, self.lifetime > 0 and self.lifetime or self.duration)
    if self.look == "active" then start_grace(self) end
    Indicator.set_look(self, self.look, self.look == "spent" and 0 or 1)
end

local function spend(self, remaining)
    self.look = "spent"
    self.spent_at = self.elapsed
    self.spent_duration = remaining or math.max(0, self.expires_at - self.elapsed)
    Indicator.set_look(self, "spent", self.spent_duration > 0 and 1 or 0)
end

function on_message(self, message_id, message)
    if message_id ~= LOOK then return end
    if message.look == "expire" then
        if self.grace_until and self.grace_until > self.elapsed then
            self.managed = false
            self.expires_at = self.grace_until
        else
            go.delete()
        end
    elseif message.look == "spent" then
        if self.grace_until and message.remaining then
            self.spent_remaining = math.max(0, message.remaining - (self.grace_until - self.elapsed))
        elseif not self.grace_until and self.look ~= "spent" then
            spend(self, message.remaining)
        end
    elseif self.look ~= message.look then
        self.look = message.look
        if self.look == "active" then start_grace(self) end
        self.warning_at = self.elapsed
        Indicator.set_look(self, self.look)
    end
end

function update(self, dt)
    if Pause.get() then return end
    self.elapsed = self.elapsed + dt
    if self.grace_until and self.elapsed >= self.grace_until then
        self.grace_until = nil
        spend(self, self.spent_remaining)
    end
    if self.look == "warning" then
        Indicator.tint(self, "warning", self.elapsed - (self.warning_at or 0))
    elseif self.spent_duration and self.spent_duration > 0 then
        local fade = math.max(0, 1 - (self.elapsed - self.spent_at) / self.spent_duration)
        Indicator.tint(self, "spent", 0, fade)
    end
    if not self.managed and self.elapsed >= self.expires_at then go.delete() end
end
