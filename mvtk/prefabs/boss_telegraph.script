-- A warning owned by its duration or by the boss attack's fight clock.
local Indicator = require "mvtk.bosses.boss_indicator"
local Pause = require "mvtk.core.pause"
local Clock = require "mvtk.bosses.boss_clock"

go.property("shape", "line")
go.property("duration", 0.5)
go.property("size_x", 80.0)
go.property("size_y", 40.0)
go.property("facing", 1)
go.property("color_r", -1.0)
go.property("color_g", -1.0)
go.property("color_b", -1.0)
go.property("color_a", -1.0)
go.property("managed", false)
go.property("neutral", false)

function init(self)
    self.elapsed = 0
    self.indicator = Indicator.config()
    local shape = self.neutral and self.shape == "circle" and "ring" or self.shape
    self.ring = shape == "ring"
    -- Cones use a rectangular direction cue. Neither texture is a sector.
    Indicator.setup(shape, self.size_x, self.size_y)
    Indicator.set_look(self, self.neutral and "neutral" or "warning")
end

function update(self, dt)
    dt = Clock.delta(dt, Pause)
    if dt <= 0 then return end
    self.elapsed = self.elapsed + dt
    if not self.neutral then Indicator.tint(self, "warning", self.elapsed) end
    if not self.managed and Clock.reached(self.elapsed + Clock.window_lead(dt), self.duration) then go.delete() end
end
