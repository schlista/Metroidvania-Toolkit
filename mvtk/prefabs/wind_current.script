-- Baked player-only current. Keep the sensor alive while off so switching on
-- works for a player already inside; overlapping body parts share one post.
local PU = require "mvtk.prefabs.prefab_utils"
local ToggleMessages = require "mvtk.prefabs.toggle_messages"
local TriggerBus = require "mvtk.world.trigger_bus"
local SwitchState = require "mvtk.world.switch_state"
local Presentation = require "mvtk.tiled.object_presentation"
local Clock = require "mvtk.player.environment_clock"
local Surface = require "mvtk.player.surface_effects"

go.property("current_id", "")
go.property("direction", "right")
go.property("wind_mode", "push")
go.property("push_speed", 300)
go.property("angle", 0)
go.property("lift_gravity_multiple", 1.6)
go.property("max_rise_speed", 600)
go.property("on_seconds", 0)
go.property("off_seconds", 0)
go.property("start_delay", 0)
go.property("enabled", true)
go.property("room_id", "")

local function refresh(self)
    local blowing = Clock.wind_blowing(self)
    if self.blowing ~= blowing then
        self.blowing = blowing
        Presentation.visible(blowing)
    end
end

local function report_overlap(self)
    local present = not self._room_hidden and next(self.parts) ~= nil
    local phase = {
        present = present, enabled = self.enabled, clock = self.clock,
        on_seconds = self.on_seconds, off_seconds = self.off_seconds, step_left = self.step_left,
    }
    if self.wind_mode == "lift" then
        msg.post(PU.get_player_url(), "mvtk_env_lift", {
            wind = phase,
            gravity_multiple = self.lift_gravity_multiple,
            max_rise_speed = self.max_rise_speed,
            dir = self.direction == "down" and -1 or 1,
        })
    else
        local vx, vy = Surface.conveyor_vector(self.direction, self.push_speed)
        if self.angle ~= 0 then
            local radians = math.rad(self.angle)
            vx, vy = math.cos(radians) * self.push_speed, math.sin(radians) * self.push_speed
        end
        msg.post(PU.get_player_url(), "mvtk_env_push", {wind = phase, vx = vx, vy = vy})
    end
end

local function apply_enabled(self, enabled)
    self.enabled = enabled
    refresh(self)
end

-- Live signals and stored channel replay use the same transition.
local function apply_signal(self, message_id, message)
    if message_id == hash("activate") then apply_enabled(self, true)
    elseif message_id == hash("deactivate") then apply_enabled(self, false)
    elseif message_id == hash("toggle") then apply_enabled(self, not self.enabled)
    elseif not ToggleMessages.handle(self, message_id, message, apply_enabled, {truthy = true}) then
        return false
    end
    return true
end

function init(self)
    self.parts = {}
    self.clock = -math.max(0, self.start_delay)
    self.current_key = PU.resolve_id(self.current_id) or tostring(go.get_id())
    refresh(self)
    TriggerBus.register(self.current_key, msg.url())
    SwitchState.replay(require("mvtk.core.flags"), self.current_key, function(on, text)
        local signal = text ~= "" and text or (on and "activate" or "deactivate")
        apply_signal(self, hash(signal), {replayed = true})
    end)
end

function update(self, dt)
    if self._room_hidden then return end
    if require("mvtk.core.pause").get() then return end
    local elapsed, step_dt = Clock.frame(dt)
    Clock.advance(self, elapsed, function()
        if self.enabled then self.clock = self.clock + step_dt end
    end)
    refresh(self)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("trigger_response") then
        if (message.other_group or message.group) ~= hash("player") or not message.other_id then return end
        local occupied = next(self.parts) ~= nil
        self.parts[message.other_id] = message.enter and true or nil
        if occupied ~= (next(self.parts) ~= nil) then report_overlap(self) end
    else
        local enabled, hidden = self.enabled, self._room_hidden
        apply_signal(self, message_id, message)
        if next(self.parts) and (enabled ~= self.enabled or hidden ~= self._room_hidden) then
            report_overlap(self)
        end
    end
end

function final(self)
    if next(self.parts) then
        self.parts = {}
        report_overlap(self)
    end
    TriggerBus.unregister(self.current_key, msg.url())
end
