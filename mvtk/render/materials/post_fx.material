name: "post_fx"
tags: "fullscreen_quad"
vertex_program: "/mvtk/render/materials/fullscreen_quad.vp"
fragment_program: "/mvtk/render/materials/post_fx.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants {
  name: "tone"
  type: CONSTANT_TYPE_USER
  value { x: 1.0 y: 1.0 z: 1.0 }
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value { x: 1.0 y: 1.0 z: 1.0 }
}
fragment_constants {
  name: "crt"
  type: CONSTANT_TYPE_USER
  value { y: 270.0 }
}
samplers {
  name: "scene"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
