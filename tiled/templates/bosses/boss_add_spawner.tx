<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Boss Add Spawner" type="boss_add_spawner">
  <properties>
   <property name="spawner_id" type="string" value=""/>
   <property name="boss_ref" type="object" value="0"/>
   <property name="arena_ref" type="object" value="0"/>
   <property name="links" type="class" propertytype="boss_add_spawner_links">
    <properties>
     <property name="boss_id" type="string" value=""/>
     <property name="arena_id" type="string" value=""/>
    </properties>
   </property>
   <property name="enemy_type" type="string" propertytype="enemies" value="default"/>
   <property name="spawning" type="class" propertytype="boss_add_spawner_spawning">
    <properties>
     <property name="spawn_interval" type="float" value="4"/>
     <property name="spawn_count" type="int" value="1"/>
     <property name="spawn_radius" type="float" value="120"/>
     <property name="max_alive" type="int" value="3"/>
     <property name="max_total" type="int" value="0"/>
     <property name="start_delay" type="float" value="0"/>
     <property name="start_active" type="bool" value="true"/>
     <property name="active_phases" type="string" value=""/>
     <property name="despawn_on_defeat" type="bool" value="true"/>
    </properties>
   </property>
   <property name="movement_and_attacks" type="class" propertytype="boss_add_spawner_movement_and_attacks">
    <properties>
     <property name="movement" type="string" propertytype="enemy_movement" value="type_default"/>
     <property name="attack_pattern" type="string" propertytype="enemy_attack_patterns" value="type_default"/>
     <property name="attack_pattern2" type="string" propertytype="enemy_attack_patterns" value="type_default"/>
    </properties>
   </property>
   <property name="stats" type="class" propertytype="boss_add_spawner_stats">
    <properties>
     <property name="health_mult" type="float" value="1"/>
     <property name="damage_mult" type="float" value="1"/>
     <property name="speed_mult" type="float" value="1"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.8.0"/>
  </properties>
  <point/>
 </object>
</template>
