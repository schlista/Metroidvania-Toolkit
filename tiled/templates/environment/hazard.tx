<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Hazard" type="hazard" width="128" height="32">
  <properties>
   <property name="boss_ref" type="object" value="0"/>
   <property name="arena_ref" type="object" value="0"/>
   <property name="arena" type="class" propertytype="hazard_arena">
    <properties>
     <property name="arena_id" type="string" value=""/>
     <property name="boss_id" type="string" value=""/>
     <property name="active_phases" type="string" value=""/>
     <property name="hide_when_inactive" type="bool" value="true"/>
     <property name="warn_time" type="float" value="0"/>
    </properties>
   </property>
   <property name="status" type="class" propertytype="hazard_status">
    <properties>
     <property name="status_effect" propertytype="status_effects" value="none"/>
     <property name="status_duration" type="float" value="-1"/>
     <property name="status_chance" type="float" value="1"/>
    </properties>
   </property>
   <property name="elements" type="class" propertytype="hazard_elements">
    <properties>
     <property name="damage_type" propertytype="damage_types" value="none"/>
    </properties>
   </property>
   <property name="hazard_type" propertytype="hazards" value="spikes"/>
   <property name="hazard_id" type="string" value=""/>
   <property name="damage_and_knockback" type="class" propertytype="hazard_damage_and_knockback">
    <properties>
     <property name="damage" type="int" value="1"/>
     <property name="damage_interval" type="float" value="0.5"/>
     <property name="stun_t" type="float" value="-1"/>
     <property name="knockback_force" type="int" value="300"/>
     <property name="on_contact" type="string" propertytype="hazard_contact_modes" value="type_default"/>
     <property name="return_damage" type="float" value="-1"/>
     <property name="instant_kill" type="bool" value="false"/>
     <property name="required_resistance" propertytype="optional_abilities" value="none"/>
    </properties>
   </property>
   <property name="motion" type="class" propertytype="hazard_motion">
    <properties>
     <property name="retractable" type="bool" value="false"/>
     <property name="retract_time" type="float" value="2.0"/>
     <property name="extend_time" type="float" value="2.0"/>
     <property name="start_retracted" type="bool" value="false"/>
     <property name="pattern" propertytype="hazard_patterns" value="none"/>
     <property name="pattern_speed" type="float" value="1.0"/>
     <property name="retract_visual_layer" type="string" value="player"/>
     <property name="retract_hides_tiles" type="bool" value="true"/>
    </properties>
   </property>
   <property name="path_motion" type="class" propertytype="hazard_path_motion">
    <properties>
     <property name="motion_type" type="string" propertytype="hazard_motion_types" value="none"/>
     <property name="motion_path_ref" type="object" value="0"/>
     <property name="motion_pivot_ref" type="object" value="0"/>
     <property name="motion_distance_x" type="float" value="0"/>
     <property name="motion_distance_y" type="float" value="0"/>
     <property name="motion_radius" type="float" value="128"/>
     <property name="motion_speed" type="float" value="200"/>
     <property name="motion_offset" type="float" value="0"/>
     <property name="motion_wait" type="float" value="0"/>
     <property name="motion_loop" type="string" propertytype="loop_modes" value="pingpong"/>
     <property name="slam_warn" type="float" value="-1"/>
     <property name="slam_rest" type="float" value="-1"/>
     <property name="slam_drop_speed" type="float" value="1200"/>
     <property name="slam_rise_speed" type="float" value="200"/>
    </properties>
   </property>
   <property name="level" type="class" propertytype="hazard_level">
    <properties>
     <property name="level_mode" propertytype="fluid_level_modes" value="none"/>
     <property name="level_offset" type="float" value="0"/>
     <property name="level_speed" type="float" value="96"/>
     <property name="rise_speed" type="float" value="48"/>
     <property name="rise_limit" type="float" value="4"/>
     <property name="rise_start" propertytype="fluid_rise_starts" value="signal"/>
     <property name="rise_delay" type="float" value="0"/>
     <property name="level_art_layer" type="string" value=""/>
    </properties>
   </property>
   <property name="activation_and_feedback" type="class" propertytype="hazard_activation_and_feedback">
    <properties>
     <property name="enabled" type="bool" value="true"/>
     <property name="sound_on_hit" propertytype="sound_effects" value="spike_hit"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.8.0"/>
  </properties>
 </object>
</template>
