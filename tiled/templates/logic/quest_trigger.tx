<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Quest Trigger" type="quest_trigger" width="128" height="128">
  <properties>
   <property name="quest_id" type="string" value=""/>
   <property name="trigger_id" type="string" value=""/>
   <property name="quest" type="class" propertytype="quest_trigger_quest">
    <properties>
     <property name="action" type="string" propertytype="quest_trigger_actions" value="advance"/>
     <property name="step_id" type="string" value=""/>
    </properties>
   </property>
   <property name="playback" type="class" propertytype="quest_trigger_playback">
    <properties>
     <property name="auto_play" type="bool" value="true"/>
    </properties>
   </property>
   <property name="lifecycle" type="class" propertytype="quest_trigger_lifecycle">
    <properties>
     <property name="trigger_once" type="bool" value="true"/>
     <property name="persist_once" type="bool" value="true"/>
     <property name="once_flag" type="string" value=""/>
     <property name="consume_on_fire" type="bool" value="true"/>
    </properties>
   </property>
   <property name="conditions_and_outcomes" type="class" propertytype="quest_trigger_conditions_and_outcomes">
    <properties>
     <property name="requires_quest" type="string" value=""/>
     <property name="requires_quest_state" type="string" propertytype="quest_states" value="any"/>
     <property name="requires_flag" type="string" value=""/>
     <property name="skip_if_flag" type="string" value=""/>
     <property name="set_flag" type="string" value=""/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.8.0"/>
  </properties>
 </object>
</template>
